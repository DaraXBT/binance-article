{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binance-article-telegram",
  "main": "workers/telegram/index.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "minify": true,
  "secrets": {
    "required": [
      "DATABASE_URL",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "TELEGRAM_BOT_INFO",
      "APP_BASE_URL"
    ]
  }
}
