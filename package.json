    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "ws": "8.21.1",
    "shell-quote": "1.10.0",
    "@ecies/ciphers": {
      "@noble/ciphers": "1.3.0"
    },
    "jsdom": {
      "undici": "7.28.0"
    }
  }
}
