{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binance-article-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "minify": true,
  "keep_names": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "routes": [
    {
      "pattern": "binance.v27.tech",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "ENROLLMENT_CODE_PEPPER",
      "GEMINI_API_KEY",
      "AI_CREDENTIAL_KEYRING",
      "AI_CREDENTIAL_ACTIVE_KEY_ID"
    ]
  },
  "vars": {
    "GEMINI_TEXT_MODEL": "gemini-2.5-flash",
    "GEMINI_IMAGE_MODEL": "gemini-3.1-flash-image-preview"
  },
  "r2_buckets": [
    {
      "binding": "ARTICLE_ASSETS",
      "bucket_name": "binance-article-assets"
    }
  ],
  "workflows": [
    {
      "binding": "ARTICLE_JOBS",
      "name": "binance-article-jobs",
      "class_name": "ArticleJobsWorkflow",
      "script_name": "binance-article-workflows"
    }
  ]
}
