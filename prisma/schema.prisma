datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DeckStatus {
  draft
  queued
  generating
  ready
  rendering
  failed
}

enum SlideImageStatus {
  pending
  generated
  failed
}

enum JobKind {
  generate
  generate_images
  render
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum AssetFormat {
  pdf
  pptx
  png
}

model Workspace {
  id              String             @id @default(cuid())
  accessKeyHash   String             @unique
  accessKeyPrefix String
  sessions        WorkspaceSession[]
  decks           DeckProject[]
  jobRuns         JobRun[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([accessKeyPrefix])
}

model WorkspaceSession {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model DeckProject {
  id                    String         @id @default(cuid())
  workspaceId           String
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  content               String
  theme                 String         @default("default")
  customTheme           Json?
  illustrationStyle     String         @default("pixel-art")
  status                DeckStatus     @default(draft)
  generationRevision    Int            @default(0)
  lastCompletedRevision Int            @default(0)
  slides                Slide[]
  captions              CaptionPackage?
  renderAssets          RenderAsset[]
  jobRuns               JobRun[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([status])
}

model Slide {
  id          String           @id @default(cuid())
  deckId      String
  deck        DeckProject      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?
  bullets     Json
  notes       String?
  imageUrl    String?
  imageStatus SlideImageStatus @default(pending)
  imageError  String?
  imagePrompt String?
  order       Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([deckId])
  @@unique([deckId, order])
}

model CaptionPackage {
  id           String      @id @default(cuid())
  deckId       String      @unique
  deck         DeckProject @relation(fields: [deckId], references: [id], onDelete: Cascade)
  blogTitle    String?
  blogMeta     String?
  blogIntro    String?
  blogSections Json?
  blogTags     Json?
  xSingle1     String?
  xSingle2     String?
  xSingle3     String?
  xThread      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([deckId])
}

model RenderAsset {
  id              String      @id @default(cuid())
  deckId          String
  deck            DeckProject @relation(fields: [deckId], references: [id], onDelete: Cascade)
  filename        String
  format          AssetFormat
  mimeType        String
  filePath        String
  fileSize        Int?
  storageProvider String      @default("blob")
  jobId           String?
  job             JobRun?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())

  @@index([deckId])
  @@index([jobId])
  @@unique([deckId, filename])
}

model JobRun {
  id                String      @id @default(cuid())
  deckId            String
  deck              DeckProject @relation(fields: [deckId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind              JobKind
  status            JobStatus   @default(queued)
  progress          Int         @default(0)
  logs              Json
  errorCode         String?
  errorMessage      String?
  articleRevisionId String
  runId             String?
  payload           Json?
  result            Json?
  assets            RenderAsset[]
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([deckId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([status, kind])
  @@index([articleRevisionId])
}
