# ============================================
# DeckForge / xArticle — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ---------- Database ----------
# Local PostgreSQL or Neon. Remote URLs must use sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/xarticle"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/xarticle"

# ---------- Better Auth ----------
# Generate a stable secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Telegram OAuth: set both values or leave both empty.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# ---------- Gemini API (required) ----------
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ---------- Private asset storage ----------
# ARTICLE_ASSETS is a private Cloudflare R2 binding configured in Wrangler.
# Do not add R2 access keys or an r2.dev public URL to the web runtime.

# ---------- Generation Access Code (optional) ----------
# Set a code to require before generating articles (controls API token costs).
# Leave empty to allow generation without a code.
GENERATE_ACCESS_CODE=

# ---------- Job Queue ----------
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=120000

# ---------- Render ----------
RENDER_TIMEOUT_MS=60000
RENDER_OUTPUT_DIR=tmp/renders
