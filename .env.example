# ============================================
# DeckForge / xArticle — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ---------- Database ----------
# Local dev: SQLite
DATABASE_URL="file:./dev.db"
# Production: Neon Postgres (set on Vercel)
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------- Gemini API (required) ----------
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ---------- Vercel Blob Storage (required for image uploads) ----------
# Get token from: Vercel Dashboard → Storage → Blob → Token
BLOB_READ_WRITE_TOKEN=

# ---------- App Access Gate (optional) ----------
# Set a passphrase to require a code before using the app.
# Leave empty to disable the gate (open access).
APP_ACCESS_CODE=

# ---------- Generation Access Code (optional) ----------
# Set a code to require before generating articles (controls API token costs).
# Leave empty to allow generation without a code.
GENERATE_ACCESS_CODE=

# ---------- Job Queue ----------
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=120000

# ---------- Render ----------
RENDER_TIMEOUT_MS=60000
RENDER_OUTPUT_DIR=tmp/renders
