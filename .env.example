# ============================================
# xArticle — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ---------- Database ----------
# Local PostgreSQL or Neon. Remote URLs must use sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/xarticle"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/xarticle"

# ---------- Better Auth ----------
# Generate a stable secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Gemini API (required) ----------
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ---------- DeepSeek API (optional alternate text provider) ----------
# Leave the key empty for Gemini-only deployments. If enabled in production,
# set it on the article Workflow Worker.
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-chat

# ---------- Private asset storage ----------
# ARTICLE_ASSETS is a private Cloudflare R2 binding configured in Wrangler.
# Do not add R2 access keys or an r2.dev public URL to the web runtime.

# ---------- Generation access rotation secret (optional) ----------
# Admin-only rotation secret used to issue and validate one-time gac_... grants.
# This is not a reusable user-facing unlock code. Leave empty to disable the
# generation lock. Generate a strong value, for example with:
#   openssl rand -base64 48
GENERATE_ACCESS_CODE=
